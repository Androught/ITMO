    <!-- http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#Creeper -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#Creeper">
        <rdf:type rdf:resource="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#HostileMob"/>
        <drops rdf:resource="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#GunPowder"/>
        <livesIn rdf:resource="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#Overworld"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#Diamond -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#Diamond">
        <rdf:type rdf:resource="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#Ore"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#Rare"/>
        <foundIn rdf:resource="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#Overworld"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#DiamondArmor -->

