    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#Emerald -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#Emerald">
