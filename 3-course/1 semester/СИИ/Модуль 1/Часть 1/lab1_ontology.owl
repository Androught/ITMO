    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#Obsidian -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#Obsidian">
        <rdf:type rdf:resource="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#Resource"/>
        <foundIn rdf:resource="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#Nether"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#Overworld -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#Overworld">
        <rdf:type rdf:resource="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#World"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#Piglin -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#Piglin">
        <rdf:type rdf:resource="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#HostileMob"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#Trader"/>
        <drops rdf:resource="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#Gold"/>
        <livesIn rdf:resource="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#Nether"/>
        <trades rdf:resource="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#Gold"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#Villager -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#Villager">
        <rdf:type rdf:resource="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#NeutralMob"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#Trader"/>
        <livesIn rdf:resource="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#Overworld"/>
        <trades rdf:resource="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#Emerald"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#Zombie -->

