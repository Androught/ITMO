    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#EnderPearl -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#EnderPearl">
        <rdf:type rdf:resource="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#Rare"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#Enderman -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#Enderman">
        <rdf:type rdf:resource="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#HostileMob"/>
        <drops rdf:resource="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#EnderPearl"/>
