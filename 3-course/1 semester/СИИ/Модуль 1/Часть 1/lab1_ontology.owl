<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#"
     xml:base="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:lab1="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrla="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled -->

    <owl:AnnotationProperty rdf:about="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#craftedFrom -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#craftedFrom">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#Item"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#Resource"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#drops -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#drops">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#Mob"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#Resource"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#foundIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#foundIn">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#Resource"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#World"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#livesIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#livesIn">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#Mob"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#World"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#rareDrop -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#rareDrop">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#Mob"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#Resource"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#trades -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#trades">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#Mob"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#Resource"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#valuableTrade -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#valuableTrade">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#Mob"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#Resource"/>
    </owl:ObjectProperty>
    


