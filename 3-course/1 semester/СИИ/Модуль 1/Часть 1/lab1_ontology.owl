        <foundIn rdf:resource="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#Nether"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#GunPowder -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#GunPowder">
        <rdf:type rdf:resource="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#Resource"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#Iron -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#Iron">
        <rdf:type rdf:resource="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#Ore"/>
        <foundIn rdf:resource="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#Overworld"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#IronSword -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#IronSword">
        <rdf:type rdf:resource="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#Weapon"/>
        <craftedFrom rdf:resource="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#Iron"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#Nether -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#Nether">
