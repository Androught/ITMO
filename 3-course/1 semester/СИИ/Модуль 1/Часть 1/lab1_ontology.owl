        <craftedFrom rdf:resource="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#Diamond"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#DiamondSword -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/andy_/ontologies/2026/8/lab1#DiamondSword">
